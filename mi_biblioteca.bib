@article{clement1492LossAmazonian1999,
  title = {1492 and the Loss of Amazonian Crop Genetic Resources. {{I}}. {{The}} Relation between Domestication and Human Population Decline},
  author = {Clement, Charles R.},
  date = {1999-04-01},
  journaltitle = {Economic Botany},
  shortjournal = {Econ Bot},
  volume = {53},
  number = {2},
  pages = {188--202},
  issn = {1874-9364},
  doi = {10.1007/BF02866498},
  url = {https://doi.org/10.1007/BF02866498},
  urldate = {2024-05-02},
  abstract = {There may have been 4–5 million people in Amazonia at the time of European contact. These people cultivated or managed at least 138 plant species in 1492. Many of these crop genetic resources were human artifacts that required human intervention for their maintenance, i.e., they were in an advanced state of domestication. Consequently, there was a relationship between the decline of Amazonian Amerindian populations and the loss of their crop genetic heritage after contact. This relationship was influenced by the crop’s degree of domestication, its life history, the degree of landscape domestication where it was grown, the number of human societies that used it, and its importance to these societies. Amazonian crop genetic erosion probably reflects an order of magnitude loss and the losses continue today.},
  langid = {english},
  keywords = {Amazonia,Crop domestication,European contact,Genetic erosion,Landscape domestication,Pre-Columbian demography},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\QGQBRHSG\clement1999.pdf}
}

@article{clementDisentanglingDomesticationFood2021,
  title = {Disentangling {{Domestication}} from {{Food Production Systems}} in the {{Neotropics}}},
  author = {Clement, Charles R. and Casas, Alejandro and Parra-Rondinel, Fabiola Alexandra and Levis, Carolina and Peroni, Nivaldo and Hanazaki, Natalia and Cortés-Zárraga, Laura and Rangel-Landa, Selene and Alves, Rubana Palhares and Ferreira, Maria Julia and Cassino, Mariana Franco and Coelho, Sara Deambrozi and Cruz-Soriano, Aldo and Pancorbo-Olivera, Marggiori and Blancas, José and Martínez-Ballesté, Andrea and Lemes, Gustavo and Lotero-Velásquez, Elisa and Bertin, Vinicius Mutti and Mazzochini, Guilherme Gerhardt},
  date = {2021-01-28},
  journaltitle = {Quaternary},
  shortjournal = {Quaternary},
  volume = {4},
  number = {1},
  pages = {4},
  issn = {2571-550X},
  doi = {10.3390/quat4010004},
  url = {https://www.mdpi.com/2571-550X/4/1/4},
  urldate = {2025-07-07},
  abstract = {The Neolithic Revolution narrative associates early-mid Holocene domestications with the development of agriculture that fueled the rise of late Holocene civilizations. This narrative continues to be influential, even though it has been deconstructed by archaeologists and geneticists in its homeland. To further disentangle domestication from reliance on food production systems, such as agriculture, we revisit definitions of domestication and food production systems, review the late Pleistocene–early Holocene archaeobotanical record, and quantify the use, management and domestication of Neotropical plants to provide insights about the past. Neotropical plant domestication relies on common human behaviors (selection, accumulation and caring) within agroecological systems that focus on individual plants, rather than populations—as is typical of agriculture. The early archaeobotanical record includes numerous perennial and annual species, many of which later became domesticated. Some of this evidence identifies dispersal with probable cultivation, suggesting incipient domestication by 10,000 years ago. Since the Pleistocene, more than 6500, 1206 and 6261 native plant species have been used in Mesoamerica, the Central Andes and lowland South America, respectively. At least 1555, 428 and 742 are managed outside and inside food production systems, and at least 1148, 428 and 600 are cultivated, respectively, suggesting at least incipient domestication. Full native domesticates are more numerous in Mesoamerica (251) than the Andes (124) and the lowlands (45). This synthesis reveals that domestication is more common in the Neotropics than previously recognized and started much earlier than reliance on food production systems. Hundreds of ethnic groups had, and some still have, alternative strategies that do involve domestication, although they do not rely principally on food production systems, such as agriculture.},
  langid = {english},
  keywords = {Leida},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\DT7N7ZX9\Clement et al. - 2021 - Disentangling Domestication from Food Production Systems in the Neotropics.pdf}
}

@article{clementDomesticationAmazoniaEuropean2015,
  title = {The Domestication of {{Amazonia}} before {{European}} Conquest},
  author = {Clement, Charles R. and Denevan, William M. and Heckenberger, Michael J. and Junqueira, André Braga and Neves, Eduardo G. and Teixeira, Wenceslau G. and Woods, William I.},
  date = {2015-08-07},
  journaltitle = {Proceedings of the Royal Society B: Biological Sciences},
  shortjournal = {Proc. R. Soc. B.},
  volume = {282},
  number = {1812},
  pages = {20150813},
  issn = {0962-8452, 1471-2954},
  doi = {10.1098/rspb.2015.0813},
  url = {https://royalsocietypublishing.org/doi/10.1098/rspb.2015.0813},
  urldate = {2023-12-19},
  abstract = {During the twentieth century, Amazonia was widely regarded as relatively pristine nature, little impacted by human history. This view remains popular despite mounting evidence of substantial human influence over millennial scales across the region. Here, we review the evidence of an anthropogenic Amazonia in response to claims of sparse populations across broad portions of the region. Amazonia was a major centre of crop domestication, with at least 83 native species containing populations domesticated to some degree. Plant domestication occurs in domesticated landscapes, including highly modified Amazonian dark earths (ADEs) associated with large settled populations and that may cover greater than 0.1\% of the region. Populations and food production expanded rapidly within land management systems in the mid-Holocene, and complex societies expanded in resource-rich areas creating domesticated landscapes with profound impacts on local and regional ecology. ADE food production projections support estimates of at least eight million people in 1492. By this time, highly diverse regional systems had developed across Amazonia where subsistence resources were created with plant and landscape domestication, including earthworks. This review argues that the Amazonian anthrome was no less socio-culturally diverse or populous than other tropical forested areas of the world prior to European conquest.},
  langid = {english},
  keywords = {Leida},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\YVTEME97\CLEMENT et al - The domestication of Amazonia before European conquest.pdf}
}

