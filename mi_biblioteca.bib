@article{abizaidSeedSharingAmazonian2016,
  title = {Seed {{Sharing}} in {{Amazonian Indigenous Rain Forest Communities}}: A {{Social Network Analysis}} in Three {{Achuar Villages}}, {{Peru}}},
  shorttitle = {Seed {{Sharing}} in {{Amazonian Indigenous Rain Forest Communities}}},
  author = {Abizaid, Christian and Coomes, Oliver T. and Perrault-Archambault, Mathilde},
  date = {2016-10},
  journaltitle = {Human Ecology},
  shortjournal = {Hum Ecol},
  volume = {44},
