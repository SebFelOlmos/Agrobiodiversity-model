@article{passmoreKinKinInternal2021,
  title = {Kin {{Against Kin}}: {{Internal Co-selection}} and the {{Coherence}} of {{Kinship Typologies}}},
  shorttitle = {Kin {{Against Kin}}},
  author = {Passmore, Sam and Barth, Wolfgang and Quinn, Kyla and Greenhill, Simon J. and Evans, Nicholas and Jordan, Fiona M.},
  date = {2021-09},
  journaltitle = {Biological Theory},
