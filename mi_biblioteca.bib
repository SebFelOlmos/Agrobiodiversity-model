@article{emperaireApprocheComparativeDiversite2003,
  title = {Approche comparative de la diversité génétique et de la diversité morphologique des maniocs en Amazonie (Brésil et Guyanes)},
  author = {Emperaire, Laure and Robert, Thierry and McKEY, Doyle and Pujol, Benoît and Elias, Marianne},
  date = {2003},
  journaltitle = {Les Actes du BRG},
  volume = {4},
  pages = {247--267},
  abstract = {A comparative approach to genetic and morphological diversity of cassava in Amazonia (Brazil and the Guianas). We analysed genetic and morphological diversity of pools of cassava varieties cuItivated by farmers of varying cultural origin and degree of insertion into local and national economies, from seven different regions of Amazonia. Among pools, genetic diversity revealed by microsatellite markers was correlated with the number of varieties cu1tivated. Global genetic diversity of local cassava populations was thus linked to agricultural practices and to the perceptions of these resources by farmers. Variation in microsatellite markers \textbackslash vas geographically structured, reflecring among other factors the geographic limits of networks of exchange of cassava germplasm. 1ndepth genetic studies, coupled \textbackslash Vith linguistic and ethnohistorical investigations, could clarify the pathways of diffusion of cassava in Amazonia. Variation in the concentration of cyanogenic glucosides in the tuberous roots, a trait which in part detennines modes of preparation of cassava, was correlated \textbackslash Vith variation in microsatellite markers. The nature and causes of the observed differentiation of "sweet" and "bitter" varieties for these markers, assumed to be selectively neuttal, should be explored in depth. The morphological traits studied showed only very weak geographical differentiation. The range of morphological variation in a pool of varieties appeared not to be closely linked to genetic diversity or to the number of varieties recognised and maintained by farmers. Each pool of varieties has conserved a lalb{$>$}e proportion of the potential morphological diversity of the whole set ofvarietiesexamined.},
  langid = {french},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\W9GS4VX7\Empera et al. - Approche comparative de la diversité génétique et .pdf}
}

