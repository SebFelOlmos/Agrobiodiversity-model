@article{perreaultWhyChacrasSwidden2005,
  title = {Why {{Chacras}} ({{Swidden}} Gardens) {{Persist}}: {{Agrobiodiversity}}, {{Food Security}}, and {{Cultural}} Identity in the {{Ecuadorian Amazon}}},
