@article{bellPAVEPathwayHow2026,
  title = {The {{PAVE}} Pathway: How to Talk about Models with People Who Built Them, and People Who Didn’t},
  shorttitle = {The {{PAVE}} Pathway},
  author = {Bell, Andrew Reid and Troost, Christian and Filatova, Tatiana and Vincenot, Christian and Qin, Cheng-Zhi and Fiedler, Sebastian and Lemmen, Carsten and Lynch, Iseult and Pierce, Maria and Edmonds, Bruce and McIntire, Eliot and Wang, Hsiao-Hsuan and Koralewski, Tomasz E and Grant, William E and Wang, Ming and Black, Ben and Grimm, Volker},
  date = {2026-03-18},
  journaltitle = {BioScience},
  pages = {biag010},
  issn = {0006-3568, 1525-3244},
  doi = {10.1093/biosci/biag010},
  url = {https://academic.oup.com/bioscience/advance-article/doi/10.1093/biosci/biag010/8527577},
  urldate = {2026-04-29},
  abstract = {Abstract             Do you want your model findings to be used and have a place in academic or policy discourse? Then PAVE that place. For modelers, PAVE (Purpose, Assumptions, Validity, and Exploration) is a semi-structured method to communicate the suitability of models to inform a particular purpose. For users of model results, PAVE is a method for identifying the strength with which model findings inform a question of interest. For all audiences, PAVE distills more comprehensive model documentation protocols into a simple set of concepts for modelers and users alike to discuss. In doing so, PAVE solves a dilemma: there is an audience for whom formal protocols for documenting model development, testing, and analysis are everything. And there is an audience for whom such technical tools are a terrifying abyss, neither to be approached nor looked upon. PAVE is meant to help these audiences talk to each other about model findings.},
  langid = {english},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\UUMQ9R32\Bell et al. - 2026 - The PAVE pathway how to talk about models with people who built them, and people who didn’t.pdf}
}

@incollection{benderCultivationManihotEsculenta2016,
