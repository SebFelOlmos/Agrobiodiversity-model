@article{turchinDisentanglingEvolutionaryDrivers2022,
  title = {Disentangling the Evolutionary Drivers of Social Complexity: {{A}} Comprehensive Test of Hypotheses},
  shorttitle = {Disentangling the Evolutionary Drivers of Social Complexity},
  author = {Turchin, Peter and Whitehouse, Harvey and Gavrilets, Sergey and Hoyer, Daniel and François, Pieter and Bennett, James S. and Feeney, Kevin C. and Peregrine, Peter and Feinman, Gary and Korotayev, Andrey and Kradin, Nikolay and Levine, Jill and Reddish, Jenny and Cioni, Enrico and Wacziarg, Romain and Mendel-Gleason, Gavin and Benam, Majid},
  date = {2022-06-24},
  journaltitle = {Science Advances},
  shortjournal = {Sci. Adv.},
  volume = {8},
  number = {25},
  publisher = {American Association for the Advancement of Science (AAAS)},
  issn = {2375-2548},
  doi = {10.1126/sciadv.abn3517},
  url = {https://www.science.org/doi/10.1126/sciadv.abn3517},
  urldate = {2025-08-14},
  abstract = {During the Holocene, the scale and complexity of human societies increased markedly. Generations of scholars have proposed different theories explaining this expansion, which range from broadly functionalist explanations, focusing on the provision of public goods, to conflict theories, emphasizing the role of class struggle or warfare. To quantitatively test these theories, we develop a general dynamical model based on the theoretical framework of cultural macroevolution. Using this model and Seshat: Global History Databank, we test 17 potential predictor variables proxying mechanisms suggested by major theories of sociopolitical complexity (and {$>$}100,000 combinations of these predictors). The best-supported model indicates a strong causal role played by a combination of increasing agricultural productivity and invention/adoption of military technologies (most notably, iron weapons and cavalry in the first millennium BCE).},
  langid = {english},
  keywords = {Leida},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\QBQ2LVXE\Turchin et al. - 2022 - Disentangling the evolutionary drivers of social complexity A comprehensive test of hypotheses.pdf}
}

@article{turchinQuantitativeHistoricalAnalysis2018,
