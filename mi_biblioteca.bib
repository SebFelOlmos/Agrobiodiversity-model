  booktitle = {Recent {{Developments}} and {{Case Studies}} in {{Ethnobotany}}},
  author = {Bender, Mariana and Assis, Ana Luiza and Tiepo, Erasmo and Hanazaki, Natalia and Peroni, Nivaldo},
