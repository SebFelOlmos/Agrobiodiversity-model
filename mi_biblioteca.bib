  doi = {10.31235/osf.io/kuxvd},
  url = {https://osf.io/kuxvd_v1},
  urldate = {2026-04-20},
  abstract = {We review existing mathematical models describing the evolution of social institutions. We discuss the role that formal models can play in understanding institutional change. We highlight the main features such models by focusing on three related questions: What is the function of an institution? What social processes are involved in establishing institutional rules? How does institutional change occur? We illustrate these points by discussing some existing examples of how intuitions have been modeled. Inspired some major patterns of human history, and reflecting the themes of this book, we do this by separately considering institutions in small-scale, the historical emergence of complex sociopolitical institutions, and political and economic institutions in more recent societies. Explicit models of institutional evolution have been relatively few in number but offer the potential of providing important insights into a key aspect of human social organization. We highlight some of important issues that have not received much attention in current models, such as the coevolution of institutions with other aspects of culture.},
  langid = {english},
  pubstate = {prepublished},
