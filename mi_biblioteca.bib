@article{llamas-guzmanSeedExchangeNetworks2022,
  title = {Seed {{Exchange Networks}} of {{Native Maize}}, {{Beans}}, and {{Squash}} in {{San Juan Ixtenco}} and {{San Luis Huamantla}}, {{Tlaxcala}}, {{Mexico}}},
