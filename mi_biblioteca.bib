@article{vandusenOnFarmConservationRice2007,
  title = {On‐{{Farm Conservation}} of {{Rice Biodiversity}} in {{Nepal}}: {{A Simultaneous Estimation Approach}}},
  shorttitle = {On‐{{Farm Conservation}} of {{Rice Biodiversity}} in {{Nepal}}},
  author = {Van Dusen, Eric Van and Gauchan, D. and Smale, M.},
  date = {2007-06},
  journaltitle = {Journal of Agricultural Economics},
  shortjournal = {J Agricultural Economics},
  volume = {58},
