  date = {2016-01-02},
  edition = {1st edition},
  pages = {271--287},
  publisher = {Nupeea},
  abstract = {When we first had the idea of organizing this book, the actual scenario of ethnobotanical investigations and its theoretical and conceptual development seemed very clear to us: complex, with diverse approaches and perspectives. We supposed that there is not one unique “ethnobotany”, but what do exist are different and complex approaches that seek, above all, to understand a little bit more of the relationship between people and plants. As we were receiving the contributions from different researchers, we realized that our supposition was correct.Although some might think the opposite, in our view, each approach, each new color and nuance that we discover when studying those interactions, reveal to us how diffcult it is to understand phenomena of such a complex nature. From this understanding we believe that the different approaches in ethnobotany should be, above all, complementary, instead of apparently contradict each other. Each new opened window does not take off the curtains showing the entire reality, but it does show part of this reality - a reality that, even though we want it to be objective, brings with it a taste of subjectivity that is the result of the training, attitude and ideology of the observer.},
  langid = {english},
  keywords = {Lee diagonal},
