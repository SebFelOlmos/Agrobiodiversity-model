@incollection{currieCulturalEvolutionSociopolitical2023,
  title = {The {{Cultural Evolution}} of {{Sociopolitical Organization}}: {{Examining How Evolutionary Processes Acting}} at {{Different Scales Have Shaped History}}’s {{Broadest Patterns}}},
  shorttitle = {The {{Cultural Evolution}} of {{Sociopolitical Organization}}},
  booktitle = {Oxford {{Handbook}} of {{Cultural Evolution}}},
  author = {Currie, Thomas E. and Perret, Cedric},
  editor = {Tehrani, Jamshid J. and Kendal, Jeremy and Kendal, Rachel L.},
  date = {2023-08-16},
