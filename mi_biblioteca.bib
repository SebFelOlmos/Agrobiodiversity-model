@article{lopesEntreHistoriaAntiga2024,
  title = {Entre a história antiga amazônica e seu presente etnográfico: colonialismo e persistências nas trajetórias indígenas de longa duração do médio Solimões, Amazonas},
  shorttitle = {Entre a história antiga amazônica e seu presente etnográfico},
  author = {Lopes, Rafael De Almeida and Almeida, Fernando Ozorio De and Tamanaha, Eduardo and Neves, Eduardo Góes},
  date = {2024},
  journaltitle = {Boletim do Museu Paraense Emílio Goeldi. Ciências Humanas},
