  author = {Burke, Ariane and Peros, Matthew C. and Wren, Colin D. and Pausata, Francesco S. R. and Riel-Salvatore, Julien and Moine, Olivier and De Vernal, Anne and Kageyama, Masa and Boisard, Solène},
  date = {2021-07-27},
  journaltitle = {Proceedings of the National Academy of Sciences},
