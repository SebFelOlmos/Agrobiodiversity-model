@article{edgeworthDiachronousBeginningsAnthropocene2015,
  title = {Diachronous Beginnings of the {{Anthropocene}}: {{The}} Lower Bounding Surface of Anthropogenic Deposits},
  shorttitle = {Diachronous Beginnings of the {{Anthropocene}}},
  author = {Edgeworth, Matt and family=Richter, given=Dan, prefix=deB, useprefix=true and Waters, Colin and Haff, Peter and Neal, Cath and Price, Simon James},
  date = {2015-04},
  journaltitle = {The Anthropocene Review},
  shortjournal = {The Anthropocene Review},
  volume = {2},
  number = {1},
  pages = {33--58},
  issn = {2053-0196, 2053-020X},
  doi = {10.1177/2053019614565394},
  url = {https://journals.sagepub.com/doi/10.1177/2053019614565394},
  urldate = {2025-07-07},
  abstract = {Across a large proportion of Earth’s ice-free land surfaces, a solid-phase stratigraphic boundary marks the division between humanly modified ground and natural geological deposits. At its clearest, the division takes the form of an abrupt surface at the base of deposits variously called ‘artificial ground’, ‘anthropogenic ground’ or ‘archaeological stratigraphy’ – which together comprise a distinctive part of the geosphere called the ‘archaeosphere’. In other cases the bounding surface is more diffuse, gradational or mixed, due to action of non-human agencies and anthropedogenic forcings. It is alternately conformable and unconformable. Layers above typically contain artificial features, structures, artifacts and other material traces of human activity, in contrast to their relative absence in layers below. A fundamental characteristic of the boundary is that it is diachronous, still being formed and renewed today. In examining the boundary, this paper asks – does it reflect the diachronous onset and development of the Anthropocene itself?},
  langid = {english},
  keywords = {Leida},
  file = {C:\Users\jsolm\Juancho\Zotero\storage\QQVYPKHY\Edgeworth et al. - 2015 - Diachronous beginnings of the Anthropocene The lower bounding surface of anthropogenic deposits.pdf}
}

